{
    "name": "@bbx-audio/plugin",
    "version": "0.5.1",
    "description": "Shared tooling for template-derived JUCE plugins: the bbx CLI, parameter codegen, and WebView glue 🧰",
    "private": false,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/blackboxaudio/bbx_audio.git",
        "directory": "bbx_plugin/client"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./init": {
            "types": "./dist/init.d.ts",
            "import": "./dist/init.js"
        },
        "./presets": {
            "types": "./dist/presets.d.ts",
            "import": "./dist/presets.js"
        },
        "./params": {
            "types": "./dist/params.d.ts",
            "import": "./dist/params.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js"
        }
    },
    "bin": {
        "bbx": "./bin/bbx.mjs"
    },
    "files": [
        "dist",
        "bin"
    ],
    "sideEffects": [
        "./dist/init.js"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "yarn clean && yarn build:web",
        "build:web": "tsc && vite build",
        "clean": "rimraf dist",
        "dev": "vite build --watch --mode development",
        "format": "yarn format:fix",
        "format:check": "prettier --check \"**/*.{ts,js,mjs,json}\"",
        "format:fix": "prettier --write \"**/*.{ts,js,mjs,json}\"",
        "lint": "yarn lint:fix",
        "lint:check": "eslint --cache \"**/*.{ts,js,mjs}\"",
        "lint:fix": "eslint --cache --fix \"**/*.{ts,js,mjs}\"",
        "prepublishOnly": "yarn build",
        "test": "vitest run"
    },
    "peerDependencies": {
        "@bbx-audio/honey": ">=0.2.0 <1.0.0",
        "@bbx-audio/nectar": ">=0.2.0 <1.0.0",
        "vite": ">=6.0.0 <8.0.0"
    },
    "peerDependenciesMeta": {
        "@bbx-audio/honey": {
            "optional": true
        },
        "@bbx-audio/nectar": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@bbx-audio/honey": "0.2.0",
        "@bbx-audio/nectar": "0.2.0",
        "@eslint/js": "9.33.0",
        "@types/node": "22.17.2",
        "eslint": "9.33.0",
        "globals": "16.3.0",
        "jiti": "2.5.1",
        "prettier": "3.6.2",
        "rimraf": "6.0.1",
        "svelte": "5.38.2",
        "typescript": "5.9.2",
        "typescript-eslint": "8.40.0",
        "vite": "7.1.3",
        "vite-plugin-dts": "4.5.4",
        "vite-tsconfig-paths": "5.1.4",
        "vitest": "3.2.4"
    }
}
