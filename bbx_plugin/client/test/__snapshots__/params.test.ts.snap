exports[`generateCppHeader > emits the parameter ids and relay X-macro in fixture order 1`] = `
"#pragma once

// Generated by @bbx-audio/plugin -- DO NOT EDIT.

#include <juce_core/juce_core.h>

namespace parameters {
    inline const juce::String INVERT_LEFT_CHANNEL_PARAM_ID = "INVERT_LEFT_CHANNEL";
    inline const juce::String INVERT_RIGHT_CHANNEL_PARAM_ID = "INVERT_RIGHT_CHANNEL";
    inline const juce::String CHANNEL_CONFIGURATION_PARAM_ID = "CHANNEL_CONFIGURATION";
    inline const juce::String MONO_PARAM_ID = "MONO";
    inline const juce::String GAIN_PARAM_ID = "GAIN";
    inline const juce::String PAN_PARAM_ID = "PAN";
    inline const juce::String DC_OFFSET_PARAM_ID = "DC_OFFSET";
}

// clang-format off
#define BBX_FOR_EACH_PARAM_RELAY(X) \\
    X(invertLeftChannel, INVERT_LEFT_CHANNEL_PARAM_ID, juce::WebToggleButtonRelay, juce::WebToggleButtonParameterAttachment) \\
    X(invertRightChannel, INVERT_RIGHT_CHANNEL_PARAM_ID, juce::WebToggleButtonRelay, juce::WebToggleButtonParameterAttachment) \\
    X(channelConfiguration, CHANNEL_CONFIGURATION_PARAM_ID, juce::WebComboBoxRelay, juce::WebComboBoxParameterAttachment) \\
    X(mono, MONO_PARAM_ID, juce::WebToggleButtonRelay, juce::WebToggleButtonParameterAttachment) \\
    X(gain, GAIN_PARAM_ID, juce::WebSliderRelay, juce::WebSliderParameterAttachment) \\
    X(pan, PAN_PARAM_ID, juce::WebSliderRelay, juce::WebSliderParameterAttachment) \\
    X(dcOffset, DC_OFFSET_PARAM_ID, juce::WebToggleButtonRelay, juce::WebToggleButtonParameterAttachment)
// clang-format on
"
`;

